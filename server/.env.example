# DestinAI Server environment template — NEVER put real secrets in this file.
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Gemini API key from Google AI Studio. Keep it server-side only.
GEMINI_API_KEY=
# Current stable Flash model; free-tier availability depends on account/model limits.
GEMINI_MODEL=gemini-3.8-flash

GITHUB_API_TOKEN=

BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

RESUME_UPLOAD_DIR=uploads/resumes
RESUME_MAX_FILE_SIZE_MB=5
LOG_LEVEL=info
